# Your Boson AI API key. The token server uses it to mint short-lived ephemeral
# keys for the browser. It is never sent to the browser itself.
#
# Provide the key ONE of two ways:
#   1. Inline (takes precedence):
#        BOSON_API_KEY=bai-...
#   2. From a file — point at wherever you already keep the key:
#        BOSON_API_KEY_FILE=/path/to/your/bosonapi_key
#
# Copy this file to .env and fill one of them in. .env is gitignored.
BOSON_API_KEY=

# Claude Haiku 5.5 updates the interview question list after each of your
# turns (POST /api/questions). Server-side only, like the Boson key.
ANTHROPIC_API_KEY=
# BOSON_API_KEY_FILE=

# Optional overrides
# PORT=3000
# BOSON_BASE_URL=https://api.boson.ai

# Higgs Avatar (optional): a LiveKit Cloud project. The server creates a room
# and tokens and starts a Boson avatar session in it (POST /api/avatar/start).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Findings: investment thesis validation (POST /api/thesis-validation) uses OpenAI.
# OPENAI_MODEL is optional; empty = the first GPT-6 model this key can use.
# Check your key and the model with: npm run check:openai
OPENAI_API_KEY=
OPENAI_MODEL=
